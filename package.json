{
  "name": "christmas-arcade-fighters",
  "version": "5.0.0-rc.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:browser": "npm run build && npm run verify:dist && playwright test",
    "verify:dist": "node scripts/verify-dist.mjs",
    "assets:prepare": "node scripts/prepare-art.mjs",
    "voices:generate": "node scripts/generate-announcer.mjs",
    "music:generate": "node scripts/generate-music.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@echogarden/espeak-ng-emscripten": "^0.3.5",
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^26.6.6",
    "eslint": "^9.28.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  }
}
